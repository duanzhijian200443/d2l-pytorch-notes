# Local Python/editor caches; preserve experiment evidence and notebooks.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# Raw data lives locally; keep only manifests, source indexes and receipts.
data/**
!data/README.md
!data/source-inventory.json
!data/public-pool-audits.json
!data/open-pool-v13-audit/
!data/open-pool-v13-audit/README.md
!data/open-pool-v13-audit/download-receipt.json
!data/public-pools/
!data/public-pools/README.md
!data/public-pools/.gitignore

# Experiment run directories and caches.
experiments/**/metrics-first-pass/
experiments/**/oof/
experiments/**/predictions/
experiments/**/panel/
experiments/**/data/
experiments/**/cache/
experiments/**/cache-artifacts/
experiments/**/sweeps/
experiments/**/runtime/
experiments/**/artifacts/
experiments/**/outputs/
experiments/**/fixtures/**/cache/

# Bulk per-row experiment data; reviews and small summaries stay tracked.
experiments/**/collection/attempts/**/*.json
experiments/**/collection/attempts/**/*.txt
experiments/**/collection/attempts/**/*.jsonl
experiments/**/*-index.csv
experiments/**/row-features.csv
experiments/**/*.log
experiments/**/*.jsonl
!experiments/**/request-plan.jsonl
!experiments/**/prompts.jsonl

# Mixed directories: keep code/docs, ignore uploaded or downloaded data.
experiments/**/payload/**/*.csv
experiments/**/payload/**/*.jsonl
experiments/**/payload/**/*.log
experiments/**/inputs/**/*.csv
experiments/**/inputs/**/*.jsonl
experiments/**/inputs/**/*.log
experiments/**/metrics/**/*-index.csv
experiments/**/metrics/**/row-features.csv
experiments/**/logs/**/*.json
experiments/**/logs/**/*.txt
experiments/**/logs/**/*.csv
experiments/**/logs/**/*.log

# Cloud run artifacts; keep submitted code, notebooks and review notes.
cloud/**/outputs*/**/*.json
cloud/**/outputs*/**/*.csv
cloud/**/outputs*/**/*.jsonl
cloud/**/outputs*/**/*.log
cloud/**/outputs*/**/*.txt
cloud/**/results/**/*.json
cloud/**/results/**/*.csv
cloud/**/results/**/*.jsonl
cloud/**/results/**/*.log
cloud/**/payload/**/*.csv
cloud/**/payload/**/*.jsonl
cloud/**/payload/**/*.log
cloud/**/cache/
cloud/**/cache-artifacts/
cloud/**/sweeps/
cloud/**/*.log
cloud/**/*.jsonl

# Large data / model artifacts.
*.parquet
*.npz
*.npy
*.zip
*.bin
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.safetensors
*.ckpt
*.onnx
*.log
*.lock
*.tmp
